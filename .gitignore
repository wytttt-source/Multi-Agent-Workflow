# ========================================
# 保护敏感信息（极度重要，千万别传 API Key）
# ========================================
.env
.env.*
!.env.example

# ========================================
# 虚拟环境（太大，不需要传）
# ========================================
myenv/
venv/
env/

# ========================================
# Python 缓存（自动生成的，不需要传）
# ========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ========================================
# 运行产物（可重新生成，不需要传）
# ========================================
data/search_cache/
data/evidence/
# v1 口径（20 份历史记录，只读、不再写入；判定语义已过时，不入库）
data/runs/
logs/
# 注：v2 口径 data/runs_v2/E1..E6/（24 份 JSON + 1 份 .json.bak 修复前存档，约 111 KB，
#     config 段只含开关与模型名、不含任何 API Key）**随仓库提交**，
#     以便按 docs/实验记录-v2.md 与 README 第四节直接复算论文数字。
#     v3 口径 data/runs_v3/P-B0|P-F|P-R|P-H/（四臂对照记录，含 repair.rounds 轨迹）同样提交，
#     便于按 docs/修复路径对照.md 复算；换机器重跑会追加新文件，提交前请只保留正式批次。

# ========================================
# 编辑器配置（每个人的习惯不同，不需要传）
# ========================================
.vscode/
.idea/
.DS_Store

# ========================================
# 临时产物（本地调试 / 半成品 / 日志，不入库）
# ========================================
tmp_*.md
tmp_*.txt
tmp_*.log
data/_*.py
data/_*.md
data/_*.log
data/run_matrix_*.log
data/run_matrix_*.err
data/runs_smoke*/

# ========================================
# 非正式批次（只保留 data/runs_v2/ 与 data/runs_v3/ 两批入表数据）
# ========================================
data/runs_v3_scratch_*/
data/runs_v3_pre_v24/
data/runs_v3_v24a/
data/runs_v3_superseded/
data/runs_v2_superseded/
# v2.5 口径：data/runs_v4/（17 题 × 4 臂 = 68 份正式批次）随仓库提交，
#     只忽略运行日志与两个隔离目录——
#       runs_v4_infra_timeout/   运行中被 LLM 供应商超时打断、终态为「执行暂停」的尝试（重跑前的留档）
#       runs_v4_rule_fallback/   终轮由确定性规则兜底（反思 LLM 超时）的旧记录（重跑前的留档）
#     两批重跑记录都不入表，入表的是 runs_v4 里一题一臂一份的正式记录。
data/runs_v4/*.log
data/runs_v4/*.err
data/runs_v4_infra_timeout/
data/runs_v4_rule_fallback/
data/runs_v3_pre_v25/
