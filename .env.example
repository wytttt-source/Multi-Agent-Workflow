# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会入库）
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 可选开关（留空则用 config.py 默认值；支持环境变量覆盖的项见 README「开关」表）
# SEARCH_PROVIDER=deepseek
# GENERATOR_MODEL=deepseek-flash
# CRITIC_MODEL=glm-5.3-flash
# SEARCH_STORE_DIR=data/search_cache
# PASS_MIN_CITED=1
# PASS_MIN_CHARS=120
# RETRY_QUERY_MODE=missing_term
# EVIDENCE_TOP_K=3

# E1~E6 实验开关（论文 A/B 用；python experiments/run_matrix.py 会自动设置这些变量）
# ENABLE_REFLECTION=1        # E1 基线设 0：反思节点直接判「通过」
# ENABLE_COVERAGE_RULE=1     # E4 消融设 0
# ENABLE_REPEAT_RULE=1       # E5 消融设 0
# DISABLE_CONTENT_GATE=0     # E2 纯 LLM 反思设 1
# INJECT_LLM_FAIL=0          # E6 故障注入设 3
# EXP_GROUP=E3               # 实验组标签：决定 data/runs_v2/<组>/ 子目录
