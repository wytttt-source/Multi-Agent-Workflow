# ========================================
# 保护敏感信息（极度重要，千万别传 API Key）
# ========================================
.env
.env.*
!.env.example

# ========================================
# 虚拟环境（太大，不需要传）
# ========================================
myenv/
venv/
env/

# ========================================
# Python 缓存（自动生成的，不需要传）
# ========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ========================================
# 运行产物（可重新生成，不需要传）
# ========================================
data/search_cache/
data/evidence/
# v1 口径（20 份历史记录，只读、不再写入；判定语义已过时，不入库）
data/runs/
logs/
# 注：v2 口径 data/runs_v2/E1..E6/（24 份 JSON + 1 份 .json.bak 修复前存档，约 111 KB，
#     config 段只含开关与模型名、不含任何 API Key）**随仓库提交**，
#     以便按 docs/实验记录-v2.md 与 README 第四节直接复算论文数字。

# ========================================
# 编辑器配置（每个人的习惯不同，不需要传）
# ========================================
.vscode/
.idea/
.DS_Store